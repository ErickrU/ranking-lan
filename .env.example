# Copia este archivo como .env y rellena la clave.
#   cp .env.example .env
#
# Consigue una clave de desarrollo iniciando sesion en:
#   https://developer.riotgames.com/
# Las claves de desarrollo CADUCAN CADA 24 HORAS y hay que regenerarlas.
RIOT_API_KEY=RGAPI-00000000-0000-0000-0000-000000000000

# Puerto del servidor de desarrollo.
PUERTO=8080

# Plataforma de la region.
#   la1 = LAN (Latinoamerica Norte)   <- por defecto
#   la2 = LAS (Latinoamerica Sur)
#   na1 = Norteamerica, br1 = Brasil, kr = Corea, euw1 = Europa Oeste...
PLATAFORMA=la1

# Cuantos jugadores resolver con nombre por listado.
# Cada jugador cuesta una llamada extra a account-v1 y una clave de desarrollo
# permite 100 peticiones cada 2 minutos: 25 es un valor prudente.
TOP_JUGADORES=25

# Segundos que el servidor reutiliza una respuesta antes de volver a preguntar
# a Riot. El ladder no cambia cada segundo.
TTL_SEGUNDOS=600
